# 外部依赖：不进仓库，靠 deps.json + bootstrap.sh 拉取
vendor/

# 大文件与可重新生成的产物（只留在本机）
*.mp4
*.mov
*.wav
*.mp3
*.m4a
*.aac
node_modules
.venv/
build_*/
renders/
stills/
out/
films/*/audio/
films/*/stills/
works/*/video/public/assets/
works/*/video/review/*/judge_*/
works/*/video/review/*/SC*_*.jpg
works/*/video/audio/cache/
works/*/voice-samples/
__pycache__/
.DS_Store
# 模板自带字体（anything2explainer，OFL），新建项目时会重新带上
works/*/video/public/fonts/
# 迭代过程截图只留最后一轮
works/rainy-corner-diorama/screenshots/r[0-8]-*
works/rainy-corner-diorama/screenshots/v*-*
.workflow/
works/rainy-corner-diorama/screenshots/dbg-*

# 例外：压缩过的预览视频要进仓库（GitHub Pages 播放用，每个 ≤10MB）
!assets/previews/*.mp4

# 《违背的青春》MV：逐帧渲染、豆包原图、切好的姿势图、字体都很大，只留本机（重渲要拷 chalk/design 和 chalk/fonts）
# 进仓库的图只有 works/weibei-youth-mv/preview/ 里挑过的几张小图
works/weibei-youth-mv/**/*.png
works/weibei-youth-mv/**/*.jpg
!works/weibei-youth-mv/preview/*.jpg
works/weibei-youth-mv/**/*.ttf
works/weibei-youth-mv/**/*.log
